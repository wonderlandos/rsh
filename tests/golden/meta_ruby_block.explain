   1 R  # SPDX-License-Identifier: GPL-2.0-or-later
   2 R  # Bare words the reader cannot know (methods made at run time by method_missing) need one of:
   3 R  # rsh_methods :name (by name), `ruby do ... end` / `ruby { ... }` (a block), `ruby!` (the rest).
   4 R  class Recorder
   5 R    attr_reader :calls
   6    
   7 R    def initialize = (@calls = [])
   8    
   9 R    def method_missing(name, *args)
  10 R      @calls << [name, *args]
  11 R      self
  12 R    end
  13    
  14 R    def respond_to_missing?(*) = true
  15 R  end
  16    
