mode: shell
methods: banner cycle initialize name port px py show start stop sum to_s
   1 R  # SPDX-License-Identifier: GPL-2.0-or-later
   2 R  # define_method with a literal name, attr_reader and Struct members: the reader knows these bare
   3 R  # words are Ruby. Names made from a list are only known at run time: rsh_methods declares them.
   4 R  class Site
   5 R    attr_reader :name, :port
   6 R    define_method(:banner) { "site #{name}:#{port}" }
   7    
   8 R    def initialize(name, port)
   9 R      @name = name
  10 R      @port = port
  11 R    end
  12    
  13 R    def show
  14 R      banner
  15 R    end
  16    
  17 R    %w[start stop].each do |verb|
  18 C      define_method("#{verb}!") { echo #{verb} #{name} }
  19 R      define_method(verb) { "#{verb} #{name}" }
  20 R    end
  21 R    rsh_methods :start, :stop
  22    
  23 R    def cycle
  24 R      a = stop
  25 R      b = start
  26 R      "#{a}, then #{b}"
  27 R    end
  28 R  end
  29    
  30 R  s = Site.new("a b; rm -rf /", 8080)
  31 R  puts s.show
  32 R  puts s.cycle
  33 R  s.start!
  34 R  s.stop!
  35 R  p Site.instance_methods(false).sort
  36 R  p s.respond_to?(:start), s.method(:banner).arity
  37    
  38 R  Point = Struct.new(:px, :py) do
  39 R    def sum
  40 R      px + py
  41 R    end
  42    
  43 R    def to_s
  44 R      "(#{px}, #{py})"
  45 R    end
  46 R  end
  47 R  puts Point.new(2, 3).sum, Point.new(1, 2)
  48    
  49 R  # Without the declaration a bare word is a command, as the rule says: `missing_tool` is not a
  50 R  # method the reader can see, so it is run (and fails, here caught).
  51 R  begin
  52 C    missing_tool_zz 2>/dev/null
  53 R  rescue Rsh::Failed => e
  54 R    puts "command: #{e.message}"
  55 R  end
  56    
